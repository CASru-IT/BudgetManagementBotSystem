# Copy this file to .env and fill in secret values before deployment
# Example values are placeholders — do NOT commit real secrets.

# Discord bot token
Discord__Token=

# Database variables (preferred). Compose and the app will use these to build the connection string.
# Fill these and the ConnectionStrings__Db will be derived from them by docker-compose.
DB_USER=postgres
DB_PASSWORD=pass
DB_NAME=budget

# Full connection string (optional - if set, it will be used as-is)
# Example: Host=postgres;Database=budget;Username=postgres;Password=pass
ConnectionStrings__Db=Host=postgres;Database=budget;Username=postgres;Password=pass

# Admin bootstrap password
AdminBootstrap__Password=CHANGE_ME

# Evidence storage path inside container
EvidenceStorage__BasePath=/app/data/evidences

# Fiscal year start month (1-12)
FiscalYearStartMonth__Month=4

# Use in-memory database (true/false)
UseInMemoryDatabase=false
